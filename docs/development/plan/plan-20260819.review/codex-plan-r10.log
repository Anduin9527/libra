    15	use std::{fs, path::Path};
    16	
    17	fn read(relative: &str) -> String {
    18	    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join(relative);
    19	    fs::read_to_string(&path).unwrap_or_else(|error| panic!("read {relative}: {error}"))
    20	}
    21	
    22	fn cargo_version() -> String {
    23	    let text = read("Cargo.toml");
    24	    // The workspace package version is the first `version = "…"` under
    25	    // `[package]`, which is the first table in this manifest.
    26	    for line in text.lines() {
    27	        if let Some(rest) = line.strip_prefix("version = \"")
    28	            && let Some(value) = rest.strip_suffix('"')
    29	        {
    30	            return value.to_string();
    31	        }
    32	    }
    33	    panic!("Cargo.toml has no package version line");
    34	}
    35	
    36	/// The RAW `$DefaultVersion` value from the Windows installer, exactly as
    37	/// `install.ps1` will use it.
    38	///
    39	/// This surface was invisible to the guard until PD-10 and had drifted 66
    40	/// patch releases behind (`v0.18.15` against a 0.19.81 manifest). Like the
    41	/// POSIX one, the value is substituted verbatim into the download URL, so a
    42	/// stale value silently installs an old binary whenever `-Version` is not
    43	/// passed.
    44	fn install_ps1_default_version_raw() -> String {
    45	    let text = read("install.ps1");
    46	    for line in text.lines() {
    47	        let line = line.trim();
    48	        if let Some(rest) = line.strip_prefix("$DefaultVersion")
    49	            && let Some(rest) = rest.trim_start().strip_prefix('=')
    50	            && let Some(value) = rest.trim().strip_prefix('"')
    51	            && let Some(value) = value.strip_suffix('"')
    52	        {
    53	            return value.to_string();
    54	        }
    55	    }
    56	    panic!("install.ps1 has no $DefaultVersion assignment");
    57	}
    58	
    59	/// The RAW `DEFAULT_VERSION` value, exactly as `install.sh` will use it.
    60	///
    61	/// Deliberately not normalized: the shell substitutes this string verbatim
    62	/// into the download URL, so `vv0.19.76` is a broken tag, not a spelling
    63	/// variant. An earlier `trim_start_matches('v')` here stripped ANY number of
    64	/// leading `v`s, which let exactly that typo satisfy the guard.
    65	fn install_default_version_raw() -> String {
    66	    let text = read("install.sh");
    67	    for line in text.lines() {
    68	        if let Some(rest) = line.strip_prefix("DEFAULT_VERSION=\"")
    69	            && let Some(value) = rest.strip_suffix('"')
    70	        {
    71	            return value.to_string();
    72	        }
    73	    }
    74	    panic!("install.sh has no DEFAULT_VERSION assignment");
    75	}
    76	
    77	#[test]
    78	fn all_release_version_surfaces_agree() {
    79	    let cargo = cargo_version();
    80	    let install = install_default_version_raw();
    81	    let install_ps1 = install_ps1_default_version_raw();
    82	
    83	    // Exact equality against the ONE canonical spelling, `v<cargo>`. The
    84	    // value is used verbatim by the shell, so anything else — a stale
    85	    // version, a missing prefix, or a doubled one — is a broken download.
    86	    assert_eq!(
    87	        install_ps1,
    88	        format!("v{cargo}"),
    89	        "install.ps1 $DefaultVersion must be exactly \"v{cargo}\" — the Windows \
    90	         installer substitutes it verbatim into the release URL just like the \
    91	         POSIX one, and it is not covered by any other guard"
    92	    );
    93	    assert_eq!(
    94	        install,
    95	        format!("v{cargo}"),
    96	        "install.sh DEFAULT_VERSION must be exactly \"v{cargo}\" — it is \
    97	         substituted verbatim into the release URL, so a stale value installs \
    98	         an old binary when the release API is unreachable and a malformed \
    99	         one installs nothing at all"
   100	    );
   101	}
   102	
   103	#[test]
   104	fn install_default_version_carries_the_release_tag_prefix() {
   105	    let text = read("install.sh");
   106	    let line = text
   107	        .lines()
   108	        .find(|line| line.starts_with("DEFAULT_VERSION="))
   109	        .expect("install.sh DEFAULT_VERSION");
   110	    let value = install_default_version_raw();
   111	    let semver = value.strip_prefix('v').unwrap_or_else(|| {
   112	        panic!("DEFAULT_VERSION keeps the `v<semver>` release-tag spelling: {line}")
   113	    });
   114	    assert!(
   115	        !semver.starts_with('v'),
   116	        "exactly ONE `v` — `{value}` would be substituted into the release URL as written: {line}"
   117	    );
   118	    assert!(
   119	        semver.split('.').count() == 3
   120	            && semver
   121	                .split('.')
   122	                .all(|part| !part.is_empty() && part.bytes().all(|b| b.is_ascii_digit())),
   123	        "DEFAULT_VERSION is `v<major>.<minor>.<patch>`, not `{value}`: {line}"
   124	    );
   125	}
