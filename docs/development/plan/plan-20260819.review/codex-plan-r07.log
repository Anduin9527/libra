  2049	    /// Register an object that is already present in the configured storage.
  2050	    /// This is the retry path for callers whose payload write succeeded but
  2051	    /// durable marker registration failed. It intentionally avoids rewriting a
  2052	    /// potentially remote payload while still recreating the exact repair work.
  2053	    pub(crate) fn ensure_existing_object_index(
  2054	        &self,
  2055	        obj_id: &ObjectHash,
  2056	        content_len: usize,
  2057	        obj_type: ObjectType,
  2058	    ) -> io::Result<()> {
  2059	        if !self.exist(obj_id) {
  2060	            return Err(io::Error::new(
  2061	                io::ErrorKind::NotFound,
  2062	                format!(
  2063	                    "cannot register object {} in the cloud index because its payload is no longer present",
  2064	                    obj_id
  2065	                ),
  2066	            ));
  2067	        }
  2068	        self.enqueue_stored_object_index(&obj_id.to_string(), &obj_type.to_string(), content_len)
  2069	    }
  2070	
  2071	    fn enqueue_stored_object_index(
  2072	        &self,
  2073	        hash_str: &str,
  2074	        type_str: &str,
  2075	        data_len: usize,
  2076	    ) -> io::Result<()> {
  2077	        // Update object index asynchronously (via sequential queue). This keeps
  2078	        // foreground writes nonblocking while the marker makes retry durable.
  2079	        if let Some(db_path) = Self::index_db_path_from_base(&self.base_path)
  2080	            && db_path.exists()
  2081	        {
  2082	            let msg = IndexUpdateMsg {
  2083	                hash: hash_str.to_string(),
  2084	                obj_type: type_str.to_string(),
  2085	                size: data_len as i64,
  2086	                db_path: db_path.clone(),
  2087	                marker_path: None,
  2088	                _marker_lock: None,
  2089	                failure_counter: current_index_failure_counter(),
  2090	                pending_counter: current_index_pending_counter(),
  2091	            };
  2092	            let (batching, single_msg) = with_object_index_batch_state(&db_path, |state| {
  2093	                if state.depth > 0 {
  2094	                    // ADR-OI-04: accumulate, then publish up to 256 markers
  2095	                    // under one generation lock. The batch is flushed by
  2096	                    // `end_object_index_batch` (or automatically once it fills).
  2097	                    state.pending.push(msg);
  2098	                    (state.pending.len() >= INDEX_REPAIR_MARKER_BATCH, None)
  2099	                } else {
  2100	                    (false, Some(msg))
  2101	                }
  2102	            });
  2103	            if batching {
  2104	                flush_pending_object_index_batch(&db_path)?;
  2105	            } else if let Some(mut msg) = single_msg {
  2106	                // Single-object path keeps its existing semantics (batch = 1).
  2107	                msg.marker_path = Some(
  2108	                    persist_index_repair_marker(&msg)
  2109	                        .map_err(object_index_marker_registration_error)?,
  2110	                );
