   693	
   694	/// Write the unseal key (hex) to `~/.libra/vault-keys/<repo-id>` with
   695	/// restrictive permissions (owner-only on Unix).
   696	async fn store_unseal_key_to_home(unseal_key: &[u8]) -> Result<()> {
   697	    let path = unseal_key_path().await?;
   698	    if let Some(parent) = path.parent() {
   699	        tokio::fs::create_dir_all(parent)
   700	            .await
   701	            .context("failed to create ~/.libra/vault-keys/")?;
   702	        // Restrict directory permissions on Unix
   703	        #[cfg(unix)]
   704	        {
   705	            use std::os::unix::fs::PermissionsExt;
   706	            let perms = std::fs::Permissions::from_mode(0o700);
   707	            std::fs::set_permissions(parent, perms).with_context(|| {
   708	                format!("failed to set permissions to 700 on '{}'", parent.display())
   709	            })?;
   710	        }
   711	    }
   712	    tokio::fs::write(&path, hex::encode(unseal_key))
   713	        .await
   714	        .context("failed to write unseal key")?;
   715	    // Restrict file permissions on Unix
   716	    #[cfg(unix)]
   717	    {
   718	        use std::os::unix::fs::PermissionsExt;
   719	        let perms = std::fs::Permissions::from_mode(0o600);
   720	        std::fs::set_permissions(&path, perms).with_context(|| {
   721	            format!(
   722	                "failed to set permissions to 600 on unseal key '{}'",
   723	                path.display()
   724	            )
   725	        })?;
   726	    }
   727	    Ok(())
   728	}
