   213	    /// Set a config value (upsert).
   214	    ///
   215	    /// Functional scope:
   216	    /// - If exactly one row exists for `key`, updates it in place.
   217	    /// - If no row exists, inserts a fresh row.
   218	    /// - When the existing row is encrypted but `encrypted == false` is
   219	    ///   passed, the encryption flag is *inherited* (preserved). This avoids
   220	    ///   accidentally downgrading a sensitive value to plaintext.
   221	    ///
   222	    /// Boundary conditions:
   223	    /// - Returns `Err` if multiple rows already exist for `key` — the caller
   224	    ///   must explicitly `unset_all` first or use `add`. Mirrors `git config`'s
   225	    ///   exit code 5.
   226	    pub async fn set_with_conn<C: ConnectionTrait>(
   227	        db: &C,
   228	        key: &str,
   229	        value: &str,
   230	        encrypted: bool,
   231	    ) -> Result<()> {
   232	        let existing = config_kv::Entity::find()
   233	            .filter(config_kv::Column::Key.eq(key))
   234	            .all(db)
   235	            .await
   236	            .context("failed to query config_kv for set")?;
   237	
   238	        if existing.len() > 1 {
   239	            return Err(anyhow!(
   240	                "cannot set '{}': {} values exist for this key",
   241	                key,
   242	                existing.len()
   243	            ));
   244	        }
   245	
   246	        if let Some(row) = existing.into_iter().next() {
   247	            // Inherit encryption from existing entry if not explicitly set
   248	            let effective_encrypted = encrypted || row.encrypted != 0;
   249	            // Update existing row
   250	            let mut active: config_kv::ActiveModel = row.into();
   251	            active.value = Set(value.to_owned());
   252	            active.encrypted = Set(if effective_encrypted { 1 } else { 0 });
   253	            active
   254	                .update(db)
   255	                .await
   256	                .context("failed to update config_kv")?;
   257	        } else {
   258	            // Insert new row
   259	            let entry = config_kv::ActiveModel {
   260	                key: Set(key.to_owned()),
   261	                value: Set(value.to_owned()),
   262	                encrypted: Set(if encrypted { 1 } else { 0 }),
   263	                ..Default::default()
   264	            };
   265	            entry.save(db).await.context("failed to insert config_kv")?;
   266	        }
   267	        Ok(())
   268	    }
   269	
   270	    /// Add a value for a key (allows duplicates, for multi-value keys).
   271	    ///
   272	    /// Enforces same-key-same-state: if existing entries for this key have a
   273	    /// different encryption state, the insert is rejected. If existing entries
   274	    /// are encrypted and `encrypted` is false, the encryption state is
   275	    /// inherited (auto-promoted to encrypted).
   276	    ///
   277	    /// Boundary conditions:
   278	    /// - First-write (no rows yet) is always accepted with the requested flag.
   279	    /// - Returns `Err` when mixing plaintext and encrypted values would result.
   280	    ///   This is a hard invariant of `config_kv`; callers cannot opt out.
   281	    pub async fn add_with_conn<C: ConnectionTrait>(
   282	        db: &C,
   283	        key: &str,
   284	        value: &str,
   285	        encrypted: bool,
   286	    ) -> Result<()> {
   287	        // Check existing entries for encryption state inheritance / conflict
   288	        let existing = config_kv::Entity::find()
   289	            .filter(config_kv::Column::Key.eq(key))
   290	            .all(db)
   291	            .await
   292	            .context("failed to query config_kv for add")?;
   293	
   294	        let has_encrypted = existing.iter().any(|e| e.encrypted != 0);
   295	        let has_plaintext = existing.iter().any(|e| e.encrypted == 0);
   296	
   297	        // Inherit encryption from existing entries
   298	        let effective_encrypted = encrypted || has_encrypted;
   299	
   300	        // Reject mixed encryption states
   301	        if !existing.is_empty()
   302	            && ((effective_encrypted && has_plaintext) || (!effective_encrypted && has_encrypted))
   303	        {
   304	            return Err(anyhow!(
   305	                "cannot mix encrypted and plaintext values for the same key"
   306	            ));
   307	        }
   308	
   309	        let entry = config_kv::ActiveModel {
   310	            key: Set(key.to_owned()),
   311	            value: Set(value.to_owned()),
   312	            encrypted: Set(if effective_encrypted { 1 } else { 0 }),
   313	            ..Default::default()
   314	        };
   315	        entry
   316	            .save(db)
   317	            .await
   318	            .context("failed to add config_kv entry")?;
   319	        Ok(())
   320	    }
