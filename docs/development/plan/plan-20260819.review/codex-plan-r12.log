    52	/// Derive a 256-bit AES key from the raw unseal key using HKDF-SHA256.
    53	fn derive_token_key(unseal_key: &[u8]) -> Result<ring::aead::LessSafeKey> {
    54	    use ring::{aead, hkdf};
    55	    let salt = hkdf::Salt::new(hkdf::HKDF_SHA256, b"libra-vault-token-enc");
    56	    let prk = salt.extract(unseal_key);
    57	    let okm = prk
    58	        .expand(&[b"token-encryption"], &aead::AES_256_GCM)
    59	        .map_err(|_| anyhow!("failed to derive vault token encryption key"))?;
    60	    let key_bytes: aead::UnboundKey = okm.into();
    61	    Ok(aead::LessSafeKey::new(key_bytes))
    62	}
    63	
    64	/// Encrypt `plaintext` with AES-256-GCM using a key derived from `unseal_key`.
    65	/// Returns `nonce || ciphertext || tag` as a single byte vector.
    66	pub fn encrypt_token(unseal_key: &[u8], plaintext: &[u8]) -> Result<Vec<u8>> {
    67	    use ring::{
    68	        aead,
    69	        rand::{SecureRandom, SystemRandom},
    70	    };
    71	
    72	    let key = derive_token_key(unseal_key)?;
    73	    let rng = SystemRandom::new();
    74	    let mut nonce_bytes = [0u8; 12];
    75	    rng.fill(&mut nonce_bytes)
    76	        .map_err(|_| anyhow!("failed to generate nonce for vault token encryption"))?;
    77	    let nonce = aead::Nonce::assume_unique_for_key(nonce_bytes);
    78	
    79	    let mut in_out = plaintext.to_vec();
    80	    key.seal_in_place_append_tag(nonce, aead::Aad::empty(), &mut in_out)
    81	        .map_err(|_| anyhow!("failed to encrypt vault root token"))?;
    82	
    83	    let mut result = nonce_bytes.to_vec();
    84	    result.extend(in_out);
    85	    Ok(result)
