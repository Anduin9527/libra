    68	/// Boundary conditions:
    69	/// - Only recognises a small allowlist of truthy strings; an unknown value (e.g.
    70	///   `LIBRA_FINE_EXIT_CODES=yesplease`) leaves the flag off rather than guessing.
    71	fn fine_exit_codes_enabled() -> bool {
    72	    matches!(
    73	        env::var(LIBRA_FINE_EXIT_CODES_ENV).as_deref(),
    74	        Ok("1" | "true" | "yes" | "on")
    75	    )
    76	}
