   100	/// Flat key/value configuration access backed by the `config_kv` table.
   101	///
   102	/// Marker struct; all methods are associated functions. Calling a method
   103	/// without `_with_conn` acquires its own connection — do **not** call those
   104	/// from inside a `db.transaction(|txn| { ... })` block (deadlock).
   105	/// Parse Git's boolean config spellings (`git_parse_maybe_bool_text`):
   106	/// `true`/`yes`/`on`/`1` → `Some(true)`, `false`/`no`/`off`/`0` →
   107	/// `Some(false)` (trimmed, case-insensitive), anything else → `None`.
   108	/// SHARED by every `core.bare` reader so a valid non-literal spelling can
   109	/// never classify differently across commands.
   110	pub fn parse_git_bool(value: &str) -> Option<bool> {
   111	    match value.trim() {
   112	        v if v.eq_ignore_ascii_case("true")
   113	            || v.eq_ignore_ascii_case("yes")
   114	            || v.eq_ignore_ascii_case("on")
   115	            || v == "1" =>
   116	        {
   117	            Some(true)
   118	        }
   119	        v if v.eq_ignore_ascii_case("false")
   120	            || v.eq_ignore_ascii_case("no")
   121	            || v.eq_ignore_ascii_case("off")
   122	            || v == "0" =>
   123	        {
   124	            Some(false)
   125	        }
   126	        _ => None,
   127	    }
   128	}
