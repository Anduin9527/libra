    54	pub const LIBRA_ERROR_JSON_ENV: &str = "LIBRA_ERROR_JSON";
    55	/// Env var that switches exit codes from the Git-style 128/129 to the legacy
    56	/// fine-grained 2..=9 category codes. Recognised values: `1`, `true`, `yes`, `on`.
    57	pub const LIBRA_FINE_EXIT_CODES_ENV: &str = "LIBRA_FINE_EXIT_CODES";
    58	/// Canonical issue tracker URL shown for unexpected internal failures.
