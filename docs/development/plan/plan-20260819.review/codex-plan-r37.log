   106	const INDEX_REPAIR_LOCK_DIR: &str = "object-index-repair-locks";
   107	const INDEX_REPAIR_GENERATION_LOCK: &str = "object-index-repair-generation.lock";
   108	// Four hexadecimal digits cap the persistent cross-process lock namespace at
   109	// 65,536 files while keeping unrelated object writes well distributed.
   110	const INDEX_REPAIR_LOCK_SHARD_HEX_LEN: usize = 4;
   111	const INDEX_REPAIR_MARKER_SCHEMA_VERSION: u8 = 1;
   112	const INDEX_REPAIR_MARKER_READ_CAP: u64 = 16 * 1024;
