  1069	    /// Initialise the AI orphan branch with an empty tree commit.
  1070	    ///
  1071	    /// This should be called once during `libra init` so that the AI ref
  1072	    /// exists from the start (parallel to `refs/heads/<branch>`).
  1073	    /// If the ref already exists this is a no-op.
  1074	    ///
  1075	    /// Functional scope:
  1076	    /// - Writes a single empty-tree commit and points the ref at it. The
  1077	    ///   commit has no parents (it is the root of the orphan branch) and
  1078	    ///   uses the canonical `Libra <ai@libra>` signatures so authorship is
  1079	    ///   traceable.
  1080	    ///
  1081	    /// Boundary conditions:
  1082	    /// - Returns early if the ref already exists; this makes the call
  1083	    ///   idempotent and safe to invoke from `libra init` regardless of
  1084	    ///   whether previous initialisations completed.
  1085	    /// - Surfaces errors from object serialisation, blob writing, or the
  1086	    ///   ref CAS so the caller can present an actionable message.
  1087	    pub async fn init_branch(&self) -> Result<()> {
  1088	        // Already initialised — nothing to do.
  1089	        if self.resolve_history_head().await?.is_some() {
  1090	            return Ok(());
  1091	        }
  1092	
  1093	        // Write an empty tree.
  1094	        let empty_tree_hash = self.write_tree(&[])?;
  1095	
  1096	        let author = Signature::new(
  1097	            SignatureType::Author,
  1098	            "Libra".to_string(),
  1099	            "ai@libra".to_string(),
  1100	        );
  1101	        let committer = Signature::new(
  1102	            SignatureType::Committer,
  1103	            "Libra".to_string(),
  1104	            "ai@libra".to_string(),
  1105	        );
  1106	
  1107	        let commit = Commit::new(
  1108	            author,
  1109	            committer,
  1110	            empty_tree_hash,
  1111	            vec![],
  1112	            "Initialize AI history branch",
  1113	        );
  1114	
  1115	        let commit_data = commit
  1116	            .to_data()
  1117	            .context("Failed to serialize AI history init commit")?;
  1118	        let commit_hash = write_git_object(&self.repo_path, "commit", &commit_data)?;
  1119	        self.update_ref(&self.ref_name, commit_hash).await?;
  1120	
  1121	        Ok(())
  1122	    }
