     1	//! Bridge protocol v1 — the authoritative machine contract for
     2	//! `libra agent bridge --stdio` (plan-20260818 LB-01, ADR-LB-01/02/03).
     3	//!
     4	//! Everything a peer must agree on to speak to the bridge lives here:
     5	//! protocol version, capability matrix, the exact 20-method allowlist, the
     6	//! v1 frame/batch limits, JSON-RPC 2.0 frame shapes and the stable error
     7	//! catalogue with retryability. The TypeScript plugin consumes the fixture
     8	//! generated from these constants; it must not redefine any of them.
     9	//!
    10	//! All constraints are `const` so the schema, tests and documentation can
    11	//! never drift from the implementation (GC-LB-02).
    12	
    13	use serde::Serialize;
    14	use serde_json::Value;
    15	
    16	/// Fixed bridge source identity (ADR-LB-02). `deepseek-harness` is NOT an
    17	/// `AgentKind`; it is the source label on every bridge durable row.
    18	pub const SOURCE_DEEPSEEK_HARNESS: &str = "deepseek-harness";
    19	
    20	/// The negotiated protocol version. `major` is a hard fail-closed contract:
    21	/// a peer that declares a different major is refused before any request is
    22	/// processed (GC-LB-05). `minor` allows additive, backward-compatible fields
    23	/// on the same major.
    24	pub const PROTOCOL_MAJOR: u32 = 1;
    25	pub const PROTOCOL_MINOR: u32 = 0;
    26	
    27	/// JSON-RPC 2.0 framing (ADR-LB-01): newline-delimited JSON on stdout;
    28	/// diagnostics only on stderr (GC-LB-04).
    29	pub const JSONRPC_VERSION: &str = "2.0";
    30	
    31	// ---------------------------------------------------------------------------
    32	// v1 contract limits (shared with `docs/development/tracing/deepseek-harness.md`
    33	// and both `plan-20260818.md` files; the fixture asserts these values).
    34	// ---------------------------------------------------------------------------
    35	
    36	/// A single NDJSON frame (request line or response line) may not exceed this.
    37	pub const MAX_FRAME_BYTES: usize = 256 * 1024;
    38	/// Maximum concurrent in-flight requests on one connection.
    39	pub const MAX_INFLIGHT: usize = 64;
    40	/// Maximum events in a single `event.append` batch.
    41	pub const MAX_BATCH_EVENTS: usize = 64;
    42	/// Maximum total payload bytes across one `event.append` batch.
    43	pub const MAX_BATCH_BYTES: usize = 256 * 1024;
    44	/// Maximum size of one event payload.
    45	pub const MAX_EVENT_BYTES: usize = 256 * 1024;
    46	/// Maximum size of one method result (response payload).
    47	pub const MAX_RESULT_BYTES: usize = 256 * 1024;
    48	/// Maximum rows returned for a history/checkpoint page.
    49	pub const MAX_PAGE: usize = 100;
    50	/// Maximum bridge session rows scanned in one paginated read.
    51	pub const MAX_SESSION_PAGE: usize = 500;
    52	
    53	// ---------------------------------------------------------------------------
    54	// The v1 method allowlist (20 methods). Implementations must dispatch on
    55	// these literal names; the model-visible tool aliases (`libra_context`, …)
    56	// are a TypeScript facade and are NOT bridge methods.
    57	// ---------------------------------------------------------------------------
    58	
    59	/// The complete, ordered v1 method allowlist. This is the single source of
    60	/// truth for which methods the bridge may ever dispatch; unknown methods are
    61	/// rejected fail-closed (GC-LB-05).
    62	pub const METHOD_ALLOWLIST: &[&str] = &[
    63	    "initialize",
    64	    "session.open",
    65	    "event.append",
    66	    "session.flush",
    67	    "session.close",
    68	    "evidence.append",
    69	    "provenance.append",
    70	    "context.get",
    71	    "status.get",
    72	    "diff.get",
    73	    "history.search",
    74	    "checkpoint.create",
    75	    "checkpoint.list",
    76	    "checkpoint.show",
    77	    "checkpoint.restore",
    78	    "commit.create",
    79	    "review.run",
    80	    "workspace.claim",
    81	    "workspace.renew",
    82	    "workspace.release",
    83	];
    84	
    85	/// The allowlist as an efficient set for O(1) membership checks.
    86	pub struct MethodAllowlist;
    87	
    88	impl MethodAllowlist {
    89	    /// `true` when `method` is one of the 20 v1 methods.
    90	    pub fn contains(method: &str) -> bool {
    91	        METHOD_ALLOWLIST.contains(&method)
    92	    }
    93	}
    94	
    95	/// Protocol version handed to a peer in the `initialize` result and echoed on
    96	/// every response so the peer can detect silent downgrade (GC-LB-05).
    97	#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
    98	pub struct ProtocolVersion {
    99	    pub major: u32,
   100	    pub minor: u32,
   101	}
   102	
   103	impl ProtocolVersion {
   104	    pub const fn current() -> Self {
   105	        Self {
   106	            major: PROTOCOL_MAJOR,
   107	            minor: PROTOCOL_MINOR,
   108	        }
   109	    }
   110	}
   111	
   112	/// The capabilities a peer negotiates and the bridge confirms. `methods` is
   113	/// the full allowlist; a peer may advertise a subset it intends to use, but
   114	/// the bridge always enforces the full allowlist server-side.
   115	#[derive(Debug, Clone, Serialize)]
   116	pub struct BridgeCapability {
   117	    pub protocol: ProtocolVersion,
   118	    /// Frame/batch/result limits the peer must respect.
   119	    pub limits: BridgeLimits,
   120	    /// Methods the bridge accepts. Always the full allowlist.
   121	    pub methods: Vec<&'static str>,
   122	    /// Fixed source identity for this bridge.
   123	    pub source: &'static str,
   124	}
   125	
   126	/// Hard v1 limits advertised to the peer (GC-LB-11). The fixture asserts
   127	/// these exact values.
   128	#[derive(Debug, Clone, Serialize)]
   129	pub struct BridgeLimits {
   130	    pub max_frame_bytes: usize,
   131	    pub max_inflight: usize,
   132	    pub max_batch_events: usize,
   133	    pub max_batch_bytes: usize,
   134	    pub max_event_bytes: usize,
   135	    pub max_result_bytes: usize,
