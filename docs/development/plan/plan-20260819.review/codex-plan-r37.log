    70	// Dedicated runtime for storage operations to avoid blocking/deadlocks in the main runtime.
    71	// We never `await` storage from the calling tokio runtime; instead we hand the work to
    72	// this private runtime and block on an mpsc receiver. This avoids `block_on within
    73	// runtime` panics and decouples storage IO from the caller's executor.
    74	static RUNTIME: Lazy<Runtime> = Lazy::new(|| {
    75	    // INVARIANT: `Builder::build()` only fails on platform resource
    76	    // exhaustion (cannot spawn the I/O reactor or worker threads). If
    77	    // that happens the process cannot make progress regardless, so
    78	    // surfacing the panic immediately is the right behavior. The
    79	    // panic message identifies that this is the storage runtime so
    80	    // the failure is distinguishable from caller-runtime issues.
    81	    tokio::runtime::Builder::new_multi_thread()
    82	        .enable_all()
    83	        .build()
    84	        .expect("failed to build dedicated tokio runtime for ClientStorage IO")
    85	});
    86	
    87	// Message describing a single object_index update queued by `ClientStorage::put`.
    88	// Carries enough state for the consumer to run independently of the calling thread.
    89	struct IndexUpdateMsg {
    90	    hash: String,
    91	    obj_type: String,
    92	    size: i64,
    93	    db_path: PathBuf,
    94	    marker_path: Option<PathBuf>,
    95	    // Replay keeps this cross-process lock through the SQLite upsert and
    96	    // marker retirement. Queued writers acquire the same bounded OID-shard lock
    97	    // immediately before touching SQLite, so a marker retired by replay is a
    98	    // durable ownership fence rather than a racy existence hint.
    99	    _marker_lock: Option<Arc<ObjectIndexRepairLock>>,
   100	    failure_counter: Arc<AtomicUsize>,
   101	    pending_counter: Arc<AtomicUsize>,
   102	}
