    74	macro_rules! uuid_newtype {
    75	    ($(#[$meta:meta])* $name:ident) => {
    76	        $(#[$meta])*
    77	        #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
    78	        #[serde(transparent)]
    79	        pub struct $name(pub Uuid);
    80	
    81	        impl $name {
    82	            pub fn new() -> Self {
    83	                Self(Uuid::new_v4())
    84	            }
    85	        }
    86	
    87	        impl Default for $name {
    88	            fn default() -> Self {
    89	                Self::new()
    90	            }
    91	        }
    92	
    93	        impl From<Uuid> for $name {
    94	            fn from(uuid: Uuid) -> Self {
    95	                Self(uuid)
    96	            }
    97	        }
    98	
    99	        impl From<$name> for Uuid {
   100	            fn from(id: $name) -> Self {
   101	                id.0
   102	            }
   103	        }
   104	    };
   105	}
