    32	/// Append-only store for per-run agent event transcripts, rooted at a
    33	/// `.libra/sessions` directory.
    34	///
    35	/// The store is stateless beyond the root path: each call resolves the
    36	/// run's transcript path and performs a single append or a full read.
    37	///
    38	/// # Single-writer-per-run invariant
    39	///
    40	/// A given run's transcript is written by exactly one producer — the
    41	/// runtime driving that `AgentRun`, which emits the run's lifecycle
    42	/// events sequentially (one append per event as the run progresses).
    43	/// The store deliberately takes no lock: distinct runs write distinct
    44	/// paths, and a single run is never appended to concurrently. Under
    45	/// that invariant each [`append`](Self::append) writes a complete line
    46	/// and the transcript is never torn. The store is **not** a concurrent
    47	/// multi-writer queue for one run; callers that would fan multiple
    48	/// threads into the same run's transcript must serialize themselves.
    49	#[derive(Clone, Debug)]
    50	pub struct AgentRunEventStore {
    51	    /// The `.libra/sessions` directory that holds `{thread_id}/...` trees.
    52	    sessions_root: PathBuf,
    53	}
    54	
    55	impl AgentRunEventStore {
    56	    /// Construct a store rooted at a `.libra/sessions` directory.
    57	    pub fn new(sessions_root: impl Into<PathBuf>) -> Self {
    58	        Self {
    59	            sessions_root: sessions_root.into(),
    60	        }
    61	    }
    62	
    63	    /// Resolve the per-run transcript path
    64	    /// `.libra/sessions/{thread_id}/agents/{run_id}.jsonl`.
    65	    ///
    66	    /// The `agents/` segment is what separates run transcripts from the
    67	    /// main session's `events.jsonl`, satisfying the CEX-S2-11 (3)
    68	    /// requirement that run events never land in the main session file.
    69	    pub fn transcript_path(&self, thread_id: Uuid, run_id: AgentRunId) -> PathBuf {
    70	        self.sessions_root
    71	            .join(thread_id.to_string())
    72	            .join("agents")
    73	            .join(format!("{}.jsonl", run_id.0))
    74	    }
    75	
    76	    /// Append one event as a single JSON line, creating the
    77	    /// `{thread_id}/agents/` parent directories on first write.
    78	    ///
    79	    /// The event is serialized through [`AgentRunEvent`]'s
