     8	/// Lifecycle status of an `AgentRun`. Five reachable states matching
     9	/// CEX-S2-16 agent projection requirements.
    10	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    11	#[serde(rename_all = "snake_case")]
    12	#[non_exhaustive]
    13	pub enum AgentRunStatus {
    14	    Queued,
    15	    Running,
    16	    Blocked,
    17	    Completed,
    18	    Failed,
    19	}
    20	
    21	impl AgentRunStatus {
    22	    /// `true` for the **terminal** states — `Completed` / `Failed` —
    23	    /// from which no further status transition occurs.
    24	    ///
    25	    /// Written as an exhaustive `match` (not `matches!`) so that adding
    26	    /// a future variant to this `#[non_exhaustive]` enum is a
    27	    /// compile error here until it is explicitly classified as terminal
    28	    /// or non-terminal — terminal-ness is never inferred by default.
    29	    ///
    30	    /// `is_terminal()` and [`is_in_flight()`](Self::is_in_flight)
    31	    /// partition the enum: exactly one is `true` for every variant.
    32	    pub fn is_terminal(self) -> bool {
    33	        match self {
    34	            Self::Completed | Self::Failed => true,
    35	            Self::Queued | Self::Running | Self::Blocked => false,
    36	        }
    37	    }
    38	
    39	    /// `true` for the **non-terminal** states — `Queued` / `Running` /
    40	    /// `Blocked` — a run that has not reached a terminal state.
    41	    /// `Blocked` is non-terminal, not terminal: a blocked run is
    42	    /// awaiting approval / human input / a budget top-up and may still
    43	    /// resume.
    44	    ///
    45	    /// Complement of [`is_terminal()`](Self::is_terminal).
    46	    pub fn is_in_flight(self) -> bool {
    47	        !self.is_terminal()
    48	    }
    49	}
