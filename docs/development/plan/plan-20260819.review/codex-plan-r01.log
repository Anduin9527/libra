mod tests {
    use super::*;

    fn pack(read: &[&str], write: &[&str]) -> AgentContextPack {
        AgentContextPack {
            task_id: AgentTaskId::new(),
            goal: "test".to_string(),
            read_scope: read.iter().map(|s| s.to_string()).collect(),
            write_scope: write.iter().map(|s| s.to_string()).collect(),
            source_intent_id: None,
        }
    }

