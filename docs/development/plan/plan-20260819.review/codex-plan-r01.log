        let unmaterialized = AgentRun {
            id: AgentRunId::new(),
            task_id: AgentTaskId::new(),
            thread_id: Uuid::new_v4(),
            provider: "deepseek".to_string(),
            model: "deepseek-chat".to_string(),
            transcript_path: ".libra/sessions/t/agents/r.jsonl".to_string(),
            workspace_path: None,
