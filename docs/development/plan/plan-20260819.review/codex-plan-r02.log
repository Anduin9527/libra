  1212	/// Returns the canonical migration set the libra runtime registers on every
  1213	/// connect. CEX-15 and CEX-16 now add migrations here in version order.
  1214	/// Keeping the set centralised in this function (rather than in
  1215	/// `establish_connection`) makes it trivial to test the wiring against an
  1216	/// isolated runner.
  1217	pub fn builtin_migrations() -> Vec<Migration> {
  1218	    super::schema::migrations_for_role(super::DatabaseRole::Repository)
  1219	}
