   164	    /// creating the `{thread_id}/agents/` parent directories on first
   165	    /// write. The whole-file overwrite is the projection contract: the
   166	    /// snapshot always reflects the run's current state, so a later write
   167	    /// supersedes an earlier one.
   168	    pub fn write_snapshot(&self, thread_id: Uuid, run: &AgentRun) -> io::Result<()> {
   169	        let path = self.snapshot_path(thread_id, run.id);
   170	        ensure_parent_dir(&path)?;
   171	        let json = serde_json::to_vec_pretty(run).map_err(io::Error::other)?;
