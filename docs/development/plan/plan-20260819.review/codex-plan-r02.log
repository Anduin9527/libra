   100	fn exact_intent_revision_lineage_intent_id<'a>(
   101	    events: &'a [CodeWorkflowEvent],
   102	    interaction_id: &str,
   103	    identity: &CodeCommandIdentity,
   104	) -> Result<Option<&'a str>, ()> {
   105	    let mut marker_count = 0usize;
   106	    let mut turn_match_count = 0usize;
   107	    let mut phase0_match_count = 0usize;
   108	    let mut lineage_intent_id = None::<&str>;
   109	    let mut lineage_phase0_turn_id = None::<&str>;
   110	    let mut latest_turn_id = None::<&str>;
   111	    let mut conflicting_intent_id = false;
   112	    let mut conflicting_phase0_turn_id = false;
   113	    for event in events {
   114	        let CodeWorkflowEventKind::IntentReviewRequested {
   115	            interaction_id: candidate_interaction_id,
   116	            intent_id,
   117	            turn_id,
   118	            phase0_turn_id,
   119	        } = &event.event
   120	        else {
   121	            continue;
   122	        };
   123	        if interaction_id != candidate_interaction_id {
   124	            continue;
   125	        }
   126	        marker_count += 1;
   127	        match lineage_intent_id {
   128	            Some(expected) if expected != intent_id => conflicting_intent_id = true,
   129	            None => lineage_intent_id = Some(intent_id),
   130	            Some(_) => {}
   131	        }
   132	        match lineage_phase0_turn_id {
   133	            Some(expected) if expected != phase0_turn_id => conflicting_phase0_turn_id = true,
   134	            None => lineage_phase0_turn_id = Some(phase0_turn_id),
   135	            Some(_) => {}
   136	        }
   137	        latest_turn_id = Some(turn_id);
   138	        turn_match_count += usize::from(turn_id == &identity.command_id);
   139	        phase0_match_count += usize::from(phase0_turn_id == &identity.command_id);
   140	    }
   141	    // A restored review can durably append replacement turn bindings for the
   142	    // same interaction. All generations must retain one IntentSpec id, while
   143	    // only the latest replacement (or the sole original Phase 0 owner) may
   144	    // terminalize it.
   145	    if marker_count == 0 {
   146	        return Ok(None);
   147	    }
   148	    let exact_current_owner = if marker_count == 1 {
   149	        turn_match_count + phase0_match_count == 1
   150	    } else {
   151	        latest_turn_id == Some(identity.command_id.as_str())
   152	            && turn_match_count == 1
   153	            && phase0_match_count == 0
   154	    };
   155	    if conflicting_intent_id || conflicting_phase0_turn_id || !exact_current_owner {
   156	        return Err(());
   157	    }
   158	    Ok(lineage_intent_id)
   159	}
