    86	/// Per-reviewer outcome recorded in `state.json` and aggregated into the
    87	/// run's terminal state.
    88	#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
    89	#[serde(rename_all = "snake_case")]
    90	pub enum ReviewerOutcome {
    91	    /// Exit status 0.
    92	    Ok,
    93	    /// Spawn failure or non-zero exit status.
    94	    Failed,
    95	    /// Killed at the per-reviewer deadline.
    96	    TimedOut,
    97	    /// Killed by the run-level cancel path.
    98	    Cancelled,
    99	}
   100	
   101	/// Deterministic terminal-state aggregation (unit-tested truth table):
   102	///
   103	/// - run-level cancel always wins → [`ReviewTerminalState::Cancelled`];
   104	/// - no reviewer ever produced an outcome (infrastructure failed before
   105	///   any reviewer ran) → [`ReviewTerminalState::Error`];
   106	/// - all `Ok` → [`ReviewTerminalState::Success`];
   107	/// - some (but not all) `Ok` → [`ReviewTerminalState::Partial`];
   108	/// - none `Ok`, at least one `TimedOut` → [`ReviewTerminalState::Timeout`];
   109	/// - none `Ok`, none `TimedOut` → [`ReviewTerminalState::Error`].
   110	pub fn aggregate_terminal_state(
   111	    cancelled: bool,
   112	    outcomes: &[ReviewerOutcome],
   113	) -> ReviewTerminalState {
   114	    if cancelled {
   115	        return ReviewTerminalState::Cancelled;
   116	    }
   117	    if outcomes.is_empty() {
   118	        return ReviewTerminalState::Error;
   119	    }
   120	    let ok = outcomes
   121	        .iter()
   122	        .filter(|o| matches!(o, ReviewerOutcome::Ok))
   123	        .count();
   124	    if ok == outcomes.len() {
   125	        ReviewTerminalState::Success
   126	    } else if ok > 0 {
   127	        ReviewTerminalState::Partial
   128	    } else if outcomes
   129	        .iter()
   130	        .any(|o| matches!(o, ReviewerOutcome::TimedOut))
   131	    {
   132	        ReviewTerminalState::Timeout
   133	    } else {
   134	        ReviewTerminalState::Error
   135	    }
   136	}
