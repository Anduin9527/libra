   207	    /// Read every persisted [`AgentRun`] snapshot across all threads under
   208	    /// this store's `sessions_root`, in unspecified order (consumers that
   209	    /// need a stable display order sort the result themselves).
   210	    ///
   211	    /// A missing `sessions_root` (or a thread dir without an `agents/`
   212	    /// subdirectory) is not an error — it yields no runs. This is the read
   213	    /// path the `/agents` pane rebuilds from, so it tolerates a partially
   214	    /// populated tree rather than failing the whole render.
   215	    pub fn list_all_snapshots(&self) -> io::Result<Vec<AgentRun>> {
   216	        let mut runs = Vec::new();
   217	        let threads = match fs::read_dir(&self.sessions_root) {
   218	            Ok(read_dir) => read_dir,
   219	            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
   220	            Err(error) => return Err(error),
   221	        };
   222	        for thread in threads {
   223	            let agents_dir = thread?.path().join("agents");
   224	            if !agents_dir.is_dir() {
   225	                continue;
   226	            }
   227	            for entry in fs::read_dir(&agents_dir)? {
   228	                let path = entry?.path();
   229	                let is_snapshot = path
   230	                    .file_name()
   231	                    .and_then(|name| name.to_str())
   232	                    .is_some_and(|name| name.ends_with(".snapshot.json"));
   233	                if !is_snapshot {
   234	                    continue;
   235	                }
   236	                let bytes = fs::read(&path)?;
   237	                let run: AgentRun = serde_json::from_slice(&bytes).map_err(io::Error::other)?;
   238	                runs.push(run);
   239	            }
   240	        }
   241	        Ok(runs)
   242	    }
   243	}
