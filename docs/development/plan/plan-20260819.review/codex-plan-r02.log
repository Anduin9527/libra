    48	
    49	/// The five terminal states every review run must end in exactly one of
    50	/// (plan.md Task A7 验收; `agent.md` §6 `agent.review.run`).
    51	#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
    52	#[serde(rename_all = "snake_case")]
    53	pub enum ReviewTerminalState {
    54	    /// Every reviewer completed with exit status 0.
    55	    Success,
    56	    /// Infrastructure failure (workspace/store), or no reviewer succeeded
    57	    /// and none timed out.
    58	    Error,
    59	    /// The run was cancelled (`review cancel` / SIGINT / SIGTERM — one
    60	    /// shared cleanup path).
    61	    Cancelled,
    62	    /// No reviewer succeeded and at least one hit its deadline.
    63	    Timeout,
    64	    /// Some — but not all — reviewers succeeded.
    65	    Partial,
    66	}
    67	
    68	impl ReviewTerminalState {
    69	    pub fn as_str(self) -> &'static str {
    70	        match self {
    71	            Self::Success => "success",
    72	            Self::Error => "error",
    73	            Self::Cancelled => "cancelled",
    74	            Self::Timeout => "timeout",
    75	            Self::Partial => "partial",
    76	        }
    77	    }
    78	}
    79	
    80	impl std::fmt::Display for ReviewTerminalState {
    81	    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
    82	        f.write_str(self.as_str())
    83	    }
    84	}
