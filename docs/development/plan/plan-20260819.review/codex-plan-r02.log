    92	    /// test; this test pins the partition property itself.)
    93	    #[test]
    94	    fn terminal_and_in_flight_partition_every_status() {
    95	        let all = [
    96	            AgentRunStatus::Queued,
    97	            AgentRunStatus::Running,
    98	            AgentRunStatus::Blocked,
    99	            AgentRunStatus::Completed,
   100	            AgentRunStatus::Failed,
   101	        ];
   102	        for status in all {
   103	            assert_ne!(
   104	                status.is_terminal(),
   105	                status.is_in_flight(),
   106	                "{status:?} must be exactly one of terminal / in-flight",
