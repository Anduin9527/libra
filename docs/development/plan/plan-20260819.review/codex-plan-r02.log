    76	    /// Append one event as a single JSON line, creating the
    77	    /// `{thread_id}/agents/` parent directories on first write.
    78	    ///
    79	    /// The event is serialized through [`AgentRunEvent`]'s
    80	    /// `tag = "kind"` / `content = "payload"` shape; readers parse it
    81	    /// back through [`AgentRunEventEnvelope`].
    82	    pub fn append(
    83	        &self,
    84	        thread_id: Uuid,
    85	        run_id: AgentRunId,
    86	        event: &AgentRunEvent,
    87	    ) -> io::Result<()> {
    88	        let path = self.transcript_path(thread_id, run_id);
    89	        ensure_parent_dir(&path)?;
    90	
    91	        let mut line = serde_json::to_string(event).map_err(io::Error::other)?;
    92	        line.push('\n');
    93	
    94	        let mut file = OpenOptions::new().create(true).append(true).open(&path)?;
    95	        file.write_all(line.as_bytes())
    96	    }
    97	
    98	    /// Read every event in a run's transcript in append order, parsing
    99	    /// each line through the forward-compatible [`AgentRunEventEnvelope`].
   100	    ///
   101	    /// Per that envelope's contract, a line lands in
   102	    /// [`AgentRunEventEnvelope::Unknown`] when it is not parseable as a
   103	    /// recognized [`AgentRunEvent`] — this covers **both** a genuinely
   104	    /// future event kind (the intended forward-compat case, S2-INV-10)
   105	    /// **and** a line whose `kind` is recognized but whose payload is
   106	    /// malformed: the untagged envelope cannot distinguish the two, so
   107	    /// data corruption surfaces as `Unknown` rather than a read error.
   108	    /// Only a line that is not valid JSON at all fails the read. Callers
   109	    /// that need to detect corruption of a known kind must re-validate
   110	    /// the `Unknown` rows against the kinds they expect.
   111	    ///
   112	    /// A missing transcript is not an error — a run that never emitted an
   113	    /// event yields an empty vec. Blank lines are skipped.
   114	    pub fn read(
   115	        &self,
   116	        thread_id: Uuid,
   117	        run_id: AgentRunId,
   118	    ) -> io::Result<Vec<AgentRunEventEnvelope>> {
   119	        let path = self.transcript_path(thread_id, run_id);
   120	        let file = match fs::File::open(&path) {
   121	            Ok(file) => file,
   122	            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
   123	            Err(error) => return Err(error),
   124	        };
   125	
   126	        let mut events = Vec::new();
   127	        for line in BufReader::new(file).lines() {
   128	            let line = line?;
   129	            if line.trim().is_empty() {
   130	                continue;
   131	            }
   132	            let envelope: AgentRunEventEnvelope =
   133	                serde_json::from_str(&line).map_err(io::Error::other)?;
   134	            events.push(envelope);
   135	        }
   136	        Ok(events)
   137	    }
