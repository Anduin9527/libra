   171	/// `created_at`, `updated_at`, `findings_oid`, `redaction_report`,
   172	/// `manual_attach`. The key-set exactness is pinned by a unit test below;
   173	/// do not add or rename fields without updating the E8 spec first.
   174	#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
   175	pub struct ReviewManifest {
