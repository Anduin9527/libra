   142	/// Deserializable summary of a redaction pass. The full
   143	/// [`RedactionReport`] is `Serialize`-only (its match list carries rule
   144	/// offsets the manifest does not need), so the manifest stores this
   145	/// round-trippable aggregate instead.
   146	#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
   147	pub struct RedactionReportSummary {
   148	    /// Total redaction rule matches across all persisted reviewer text.
   149	    pub matches: usize,
   150	    pub bytes_scanned: usize,
   151	    pub bytes_redacted: usize,
   152	}
   153	
   154	impl RedactionReportSummary {
   155	    pub fn absorb(&mut self, report: &RedactionReport) {
   156	        self.matches += report.matches.len();
   157	        self.bytes_scanned += report.bytes_scanned;
   158	        self.bytes_redacted += report.bytes_redacted;
   159	    }
   160	
   161	    pub fn merge(&mut self, other: &RedactionReportSummary) {
   162	        self.matches += other.matches;
   163	        self.bytes_scanned += other.bytes_scanned;
   164	        self.bytes_redacted += other.bytes_redacted;
   165	    }
   166	}
