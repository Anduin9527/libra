   188	    /// Read a run's persisted [`RunUsage`], or `None` when the run never
   189	    /// recorded usage (a missing file is not an error — an in-flight run
   190	    /// that has not closed a provider call yet simply has no usage).
   191	    pub fn read_run_usage(
   192	        &self,
   193	        thread_id: Uuid,
   194	        run_id: AgentRunId,
   195	    ) -> io::Result<Option<RunUsage>> {
   196	        let path = self.usage_path(thread_id, run_id);
