   185	    pub target_scope: String,
   186	    /// `null` while the run is in flight; exactly one of the five
   187	    /// terminal states once it ends.
   188	    pub terminal_state: Option<ReviewTerminalState>,
   189	    /// RFC 3339 UTC, microsecond precision (fixed width, so
