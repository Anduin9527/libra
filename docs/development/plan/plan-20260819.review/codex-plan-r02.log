    92	pub(crate) fn is_canonical_intent_revision_digest(value: &str) -> bool {
    93	    value.len() == "hmac-sha256:".len() + 64
    94	        && value.starts_with("hmac-sha256:")
    95	        && value["hmac-sha256:".len()..]
    96	            .bytes()
    97	            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
    98	}
