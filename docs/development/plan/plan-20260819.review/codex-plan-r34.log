    79	fn remote_namespace_variable<'a>(key: &'a str, remote: &str) -> Option<&'a str> {
    80	    let (name, variable) = key.strip_prefix("remote.")?.rsplit_once('.')?;
    81	    (name == remote).then_some(variable)
    82	}
