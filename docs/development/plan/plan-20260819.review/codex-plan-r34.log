    50	// ConfigKv — new flat key/value API backed by the `config_kv` table
    51	// ─────────────────────────────────────────────────────────────────────────────
    52	
    53	/// One row from the `config_kv` table, decoded for application use.
    54	///
    55	/// `encrypted == true` means `value` is hex-encoded ciphertext that must be
    56	/// decrypted via [`decrypt_value`] before display. The encrypt flag is stored
    57	/// as INTEGER (0/1) in SQLite; this struct normalises it to `bool`.
    58	#[derive(Debug, Clone, PartialEq, Eq)]
    59	pub struct ConfigKvEntry {
    60	    /// Dotted config key, e.g. `remote.origin.url` or `vault.env.GEMINI_API_KEY`.
    61	    pub key: String,
    62	    /// Either plaintext or hex ciphertext depending on `encrypted`.
    63	    pub value: String,
    64	    /// `true` when `value` is hex-encoded ciphertext.
    65	    pub encrypted: bool,
    66	}
    67	
    68	impl ConfigKvEntry {
    69	    /// Convert a sea-orm row into the public [`ConfigKvEntry`] shape.
    70	    fn from_model(m: &config_kv::Model) -> Self {
    71	        Self {
    72	            key: m.key.clone(),
    73	            value: m.value.clone(),
    74	            encrypted: m.encrypted != 0,
    75	        }
    76	    }
    77	}
