    90	            echo "✅ No third-party/rust/crates directory to check"
    91	            exit 0
    92	          fi
    93	
    94	          x=$(find third-party/rust/crates -mindepth 2 -maxdepth 2 -type d -exec bash -c '
    95	            n=$(find "$1" -maxdepth 1 -type f | wc -l)
    96	            [ $n -gt 1 ]
    97	          ' _ {} \; -print -quit | wc -l)
    98	          if [ $x -gt 0 ]; then
