    67	/// Dispatch the session/event ingress methods. Returns `None` for a
    68	/// notification (no reply). Unknown/read/mutation methods are handled by the
    69	/// surrounding dispatcher (LB-04/LB-05); this function owns the ingress set.
    70	pub async fn dispatch(
    71	    ctx: &BridgeContext,
    72	    request: &BridgeRequest,
    73	) -> Result<Option<BridgeResponse>, BridgeError> {
    74	    let id = request.id.clone().unwrap_or(Value::Null);
    75	    match request.method.as_str() {
    76	        "session.open" => Ok(Some(session_open(ctx, request, id).await?)),
    77	        "event.append" => Ok(Some(event_append(ctx, request, id).await?)),
    78	        "session.flush" => Ok(Some(session_flush(ctx, request, id).await?)),
    79	        "session.close" => Ok(Some(session_close(ctx, request, id).await?)),
    80	        "evidence.append" => Ok(Some(evidence_append(ctx, request, id, "evidence").await?)),
    81	        "provenance.append" => Ok(Some(evidence_append(ctx, request, id, "provenance").await?)),
    82	        _ => Ok(None),
    83	    }
    84	}
    85	
    86	fn param_str(params: &Option<Value>, key: &str) -> Result<String, BridgeError> {
    87	    params
    88	        .as_ref()
    89	        .and_then(|p| p.get(key))
    90	        .and_then(Value::as_str)
    91	        .map(str::to_string)
    92	        .ok_or_else(|| BridgeError::invalid_params(format!("missing or non-string '{key}'")))
    93	}
    94	
    95	async fn session_open(
    96	    ctx: &BridgeContext,
    97	    request: &BridgeRequest,
    98	    id: Value,
    99	) -> Result<BridgeResponse, BridgeError> {
   100	    let session_id = param_str(&request.params, "session_id")?;
   101	    let parent_session_id = request
   102	        .params
   103	        .as_ref()
   104	        .and_then(|p| p.get("parent_session_id"))
   105	        .and_then(Value::as_str)
   106	        .map(str::to_string);
   107	    let agent_id = request
   108	        .params
   109	        .as_ref()
   110	        .and_then(|p| p.get("agent_id"))
   111	        .and_then(Value::as_str)
   112	        .map(str::to_string);
   113	    let workspace_id = request
   114	        .params
   115	        .as_ref()
   116	        .and_then(|p| p.get("workspace_id"))
   117	        .and_then(Value::as_str)
   118	        .map(str::to_string);
   119	
   120	    let (row, created) = storage::open_session(
   121	        &ctx.conn,
   122	        &session_id,
   123	        &ctx.repository_id,
   124	        ctx.worktree_id.as_deref(),
   125	        workspace_id.as_deref(),
   126	        parent_session_id.as_deref(),
   127	        agent_id.as_deref(),
   128	        now_ms(),
   129	    )
   130	    .await
   131	    .map_err(db_error("open bridge session"))?;
   132	
   133	    // Fail-closed: an existing session must belong to this repository.
   134	    if row.repository_id != ctx.repository_id {
   135	        return Err(BridgeError::scope_mismatch(format!(
   136	            "bridge session '{session_id}' already belongs to repository '{}', not '{}'",
   137	            row.repository_id, ctx.repository_id
   138	        )));
   139	    }
   140	
   141	    // Fail-closed on a retry whose lineage differs from the stored scope
   142	    // (GC-LB-06): a second `session.open` with a different workspace /
   143	    // parent / agent must not be silently ignored. The stored scope is never
   144	    // overwritten; a mismatch is a stable error.
   145	    if !created {
