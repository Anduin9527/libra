     9	-- Idempotency: every DDL statement uses `IF NOT EXISTS`.
    10	
    11	-- One bridge session per Harness session. Scope is derived from the trusted
    12	-- handshake/context (GC-LB-06); the request body never overrides it.
    13	CREATE TABLE IF NOT EXISTS `agent_bridge_session` (
    14	    `bridge_session_id`  TEXT PRIMARY KEY,
    15	    -- Fixed source (ADR-LB-02). `deepseek-harness` is never an AgentKind.
    16	    `source`             TEXT NOT NULL CHECK(`source` = 'deepseek-harness'),
    17	    `repository_id`      TEXT NOT NULL,
    18	    `worktree_id`        TEXT,
    19	    `workspace_id`       TEXT,
    20	    `parent_session_id`  TEXT,
    21	    -- Harness agent/subagent identity (GC-LB-07 derived lineage, not self-reported).
    22	    `agent_id`           TEXT,
    23	    `session_state`      TEXT NOT NULL CHECK(`session_state` IN ('open','flushing','closed','quarantined')),
    24	    `schema_version`     INTEGER NOT NULL DEFAULT 1,
    25	    -- Highest contiguous event_seq accepted and the highest acked to the peer.
    26	    `last_event_seq`     INTEGER NOT NULL DEFAULT 0,
    27	    `last_acked_seq`     INTEGER NOT NULL DEFAULT 0,
    28	    `created_at`         INTEGER NOT NULL,
    29	    `updated_at`         INTEGER NOT NULL
    30	);
    31	
    32	-- One row per accepted event, keyed idempotently by (bridge_session_id, event_seq).
    33	-- A replay with the SAME payload_sha256 is a success no-op; a replay with a
    34	-- DIFFERENT digest at the same sequence is a conflict (fail-closed, no
    35	-- last-writer-wins). Payload is bounded to the v1 256 KiB event cap.
    36	CREATE TABLE IF NOT EXISTS `agent_bridge_event` (
    37	    `event_id`          INTEGER PRIMARY KEY AUTOINCREMENT,
    38	    `bridge_session_id` TEXT NOT NULL REFERENCES `agent_bridge_session`(`bridge_session_id`) ON DELETE CASCADE,
    39	    `event_seq`         INTEGER NOT NULL,
    40	    `event_type`        TEXT NOT NULL,
    41	    `payload_sha256`    TEXT NOT NULL,
    42	    `payload`           TEXT NOT NULL CHECK(length(`payload`) <= 262144),
    43	    `operation_id`      TEXT,
    44	    `created_at`        INTEGER NOT NULL,
    45	    UNIQUE(`bridge_session_id`, `event_seq`)
