-rw-r--r-- ... /run/media/genedna/data/libra-pr456/.git
git -C /run/media/genedna/data/libra-pr456 rev-parse --is-inside-work-tree
true
test -d /run/media/genedna/data/libra-pr456/.git
exit 1
```

