docs/development/plan/plan-20260819.review/codex-plan-r09.log-613-   MERGE_SHA="$(gh pr view --json mergeCommit --jq .mergeCommit.oid)"
docs/development/plan/plan-20260819.review/codex-plan-r09.log-614-   gh release create "v${VERSION}" --target "$MERGE_SHA" --title "v${VERSION}" --generate-notes
