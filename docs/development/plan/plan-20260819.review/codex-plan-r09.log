     1	name: Build and Release to R2
     2	
     3	on:
     4	  push:
     5	    tags:
     6	      - 'v*' # Trigger when pushing tags starting with v, e.g., v1.0.0
     7	
     8	env:
     9	  # All uploads and the publish call go through the Backend release API
    10	  # (UP-01 design §5.2): OIDC-authenticated, no long-term storage
    11	  # credentials anywhere in this workflow (GC-UP01-1).
    12	  LIBRA_RELEASE_API_BASE: 'https://libra.tools'
    13	
    14	jobs:
    15	  build-and-upload:
    16	    runs-on: ${{ matrix.target.runner }}
    17	    permissions:
    18	      contents: read
    19	      id-token: write # only to obtain short-term upload URLs from the broker
    20	    # Per-leg environments: the broker derives the write scope from this
    21	    # claim, so each leg can only presign its OWN platform's objects.
    22	    environment: release-artifacts-${{ matrix.target.os }}-${{ matrix.target.arch }}
    23	    strategy:
    24	      fail-fast: true # if it is set to true, then one job failed the other jobs will be cancelled  together.
    25	      matrix:
    26	        component: [libra]
    27	        target:
    28	          - { rust: x86_64-unknown-linux-gnu, os: linux, arch: amd64, runner: ubuntu-latest }
    29	          - { rust: aarch64-unknown-linux-gnu, os: linux, arch: arm64, runner: ubuntu-24.04-arm }
    30	          - { rust: aarch64-apple-darwin, os: darwin, arch: arm64, runner: macos-latest }
    31	          - { rust: x86_64-pc-windows-msvc, os: windows, arch: amd64, runner: windows-latest }
    32	
    33	    steps:
    34	      - name: Checkout code
    35	        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5
    36	        with:
    37	          submodules: recursive
    38	
    39	      - name: Set up Rust
    40	        uses: actions-rust-lang/setup-rust-toolchain@166cdcfd11aee3cb47222f9ddb555ce30ddb9659 # v1
    41	        with:
    42	          toolchain: stable
    43	          target: ${{ matrix.target.rust }}
    44	
    45	      - name: Install Linux dependencies
    46	        if: matrix.target.os == 'linux'
    47	        run: |
    48	          sudo apt-get update
    49	
    50	      - name: Cache cargo registry
    51	        uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
    52	        with:
    53	          path: ~/.cargo/registry
    54	          key: ${{ runner.os }}-cargo-registry-${{ hashFiles('**/Cargo.lock') }}
    55	
    56	      - name: Cache cargo index
    57	        uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
    58	        with:
    59	          path: ~/.cargo/git
    60	          key: ${{ runner.os }}-cargo-index-${{ hashFiles('**/Cargo.lock') }}
    61	
    62	      - name: Cache cargo build
    63	        uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
    64	        with:
    65	          path: target
    66	          key: ${{ runner.os }}-cargo-build-target-${{ matrix.target.rust }}-${{ hashFiles('**/Cargo.lock') }}
    67	
    68	      # plan-20260714 §A.11: release binaries must NEVER enable the
    69	      # `test-upgrade` feature (its compile-time trust-root/endpoint injection
    70	      # would let a build override the production trust root). The build below
    71	      # passes an explicit feature list; this guard fails the release if the
    72	      # test feature is ever spliced into the release build command.
    73	      - name: Reject test-upgrade feature in release build
    74	        shell: bash
    75	        run: |
    76	          if grep -nE -- '--features[^\n]*test-upgrade' .github/workflows/release.yml; then
    77	            echo "::error::release.yml must not build with the test-upgrade feature"
    78	            exit 1
    79	          fi
    80	
    81	      - name: Build Binary (Unix)
    82	        if: matrix.target.os != 'windows'
    83	        shell: bash
    84	        run: |
    85	          VERSION=${GITHUB_REF_NAME}
    86	          BINARY_NAME="${{ matrix.component }}-${{ matrix.target.os }}-${{ matrix.target.arch }}"
    87	
    88	          echo "Building $BINARY_NAME for target ${{ matrix.target.rust }}..."
    89	
    90	          RUSTFLAGS="-C strip=symbols" cargo build --locked --release --features keyring --target ${{ matrix.target.rust }}
    91	
    92	          # Create build directory and copy binary
    93	          mkdir -p build
    94	          cp target/${{ matrix.target.rust }}/release/${{ matrix.component }} build/$BINARY_NAME
    95	
    96	          # Make binary executable
    97	          chmod +x build/$BINARY_NAME
    98	
    99	          # Generate sha256 for Homebrew tap updates and CDN verification,
   100	          # plus the byte size the publish job binds into the signed manifest.
   101	          if command -v sha256sum >/dev/null 2>&1; then
   102	            sha256sum "build/$BINARY_NAME" | awk '{print $1}' > "build/$BINARY_NAME.sha256"
   103	          else
   104	            shasum -a 256 "build/$BINARY_NAME" | awk '{print $1}' > "build/$BINARY_NAME.sha256"
   105	          fi
   106	          wc -c < "build/$BINARY_NAME" | tr -d '[:space:]' > "build/$BINARY_NAME.size"
   107	
   108	          echo "Built binary: $BINARY_NAME"
   109	
   110	      - name: Build Binary (Windows)
   111	        if: matrix.target.os == 'windows'
   112	        shell: pwsh
   113	        run: |
   114	          $version = $env:GITHUB_REF_NAME
   115	          # This is the public release-contract name, including the separate
   116	          # suffixless object consumed by signed manifests.
   117	          $binaryName = "libra-windows-amd64"
   118	
   119	          Write-Output "Building $binaryName for target ${{ matrix.target.rust }}..."
   120	
   121	          $env:RUSTFLAGS = "-C strip=symbols -C link-args=/STACK:0x1000000" 
   122	          cargo build --locked --release --features keyring --target ${{ matrix.target.rust }}
   123	
   124	          # Create build directory and copy binary
   125	          New-Item -ItemType Directory -Force -Path "build" | Out-Null
   126	          $sourceBinary = "target\${{ matrix.target.rust }}\release\${{ matrix.component }}.exe"
   127	          $sourceHash = (Get-FileHash -Algorithm SHA256 $sourceBinary).Hash.ToLowerInvariant()
   128	          Copy-Item $sourceBinary "build\$binaryName.exe"
   129	          # The signed-manifest URL grammar has no `.exe` suffix. Publish a
   130	          # byte-identical second name and verify both copied release objects.
   131	          Copy-Item "build\$binaryName.exe" "build\$binaryName"
   132	          $exeHash = (Get-FileHash -Algorithm SHA256 "build\$binaryName.exe").Hash.ToLowerInvariant()
   133	          $suffixlessHash = (Get-FileHash -Algorithm SHA256 "build\$binaryName").Hash.ToLowerInvariant()
   134	          if ($sourceHash -ne $exeHash -or $sourceHash -ne $suffixlessHash) {
   135	            throw "Windows release copies do not match the built executable"
   136	          }
   137	          Set-Content -NoNewline -Path "build\$binaryName.sha256" -Value $exeHash
   138	          # The upload loop reads "<file>.sha256" per file; give the .exe its
   139	          # own (byte-identical) sidecar so both binaries resolve digests.
   140	          Set-Content -NoNewline -Path "build\$binaryName.exe.sha256" -Value $exeHash
   141	          Set-Content -NoNewline -Path "build\$binaryName.size" -Value ((Get-Item "build\$binaryName").Length)
   142	
   143	          Write-Output "Built binary: $binaryName"
   144	
   145	      - name: Upload release objects via the credential broker (Unix)
   146	        if: matrix.target.os != 'windows'
   147	        shell: bash
   148	        env:
   149	          GITHUB_REF_NAME: ${{ github.ref_name }}
   150	        run: |
   151	          set -euo pipefail
   152	          # 1. Per-object {key,size,sha256} list for everything in build/.
   153	          objects="$(cd build && for f in *; do
   154	            case "$f" in
   155	              *.sha256|*.size) sha="$( (sha256sum "$f" 2>/dev/null || shasum -a 256 "$f") | awk '{print $1}')" ;;
   156	              *) sha="$(cat "$f.sha256")" ;;
   157	            esac
   158	            [[ "$f" == *.size ]] && continue
   159	            jq -n --arg key "libra/releases/${GITHUB_REF_NAME}/$f" \
   160	              --arg sha "$sha" --argjson size "$(wc -c < "$f" | tr -d '[:space:]')" \
   161	              '{object_key: $key, sha256: $sha, size: $size}'
   162	          done | jq -s '.')"
   163	
