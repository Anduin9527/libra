    45	/// Look up a session's repository scope and verify it matches the trusted
    46	/// context (fail-closed on mismatch — a session created by another repository
    47	/// can never be written to from here).
    48	async fn require_session_in_repo(ctx: &BridgeContext, session_id: &str) -> Result<(), BridgeError> {
    49	    let session = storage::get_session(&ctx.conn, session_id)
    50	        .await
    51	        .map_err(db_error("look up bridge session"))?;
    52	    match session {
    53	        Some(row) if row.repository_id == ctx.repository_id => Ok(()),
    54	        Some(_) => Err(BridgeError::scope_mismatch(format!(
    55	            "bridge session '{session_id}' belongs to a different repository; refusing cross-repository write"
    56	        ))),
    57	        None => Err(BridgeError::scope_mismatch(format!(
    58	            "bridge session '{session_id}' is not open in this connection; call session.open first"
    59	        ))),
    60	    }
    61	}
