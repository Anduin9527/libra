    29	/// Classify a bridge mutation by its risk. Anything unknown is treated as
    30	/// `Dangerous` (fail-closed): the allowlist gates the method name earlier, and
    31	/// here we err toward requiring approval.
    32	pub fn classify(action: &str) -> ActionClass {
    33	    match action {
    34	        "checkpoint.create" | "checkpoint.list" | "checkpoint.show" | "evidence.append"
    35	        | "provenance.append" | "context.get" | "status.get" | "history.search" | "diff.get" => {
    36	            ActionClass::Normal
    37	        }
    38	        // Default deny for anything that can change working state / refs /
    39	        // remote: restore, branch-switch, reset, push, publish, delete-*,
    40	        // commit (bounded but stateful — still approval-gated here).
    41	        _ => ActionClass::Dangerous,
    42	    }
    43	}
    44	
    45	/// A caller-supplied approval decision attached to a mutation request.
    46	#[derive(Debug, Clone, PartialEq, Eq)]
    47	pub struct Approval {
    48	    /// `"approved"` or `"denied"`; anything else is a malformed approval.
    80	///
    81	/// - `Dangerous` actions with no approval, or an explicit `denied` approval,
    82	///   are refused with a stable `denied` error (never a silent success).
    83	/// - `Dangerous` actions with `approved` proceed (fence validation is layered
    84	///   on top by the caller for restore-type operations).
    85	/// - `Normal` actions do not require approval.
    86	pub fn enforce(action: &str, approval: Option<&Approval>) -> Result<(), BridgeError> {
    87	    if classify(action) == ActionClass::Normal {
    88	        return Ok(());
    89	    }
    90	    match approval {
    91	        Some(a) if a.decision == "approved" => Ok(()),
    92	        Some(a) => Err(BridgeError::denied(format!(
    93	            "mutation '{action}' was denied by approval (approver: {})",
    94	            a.approver.as_deref().unwrap_or("unknown")
    95	        ))),
    96	        None => Err(BridgeError::denied(format!(
    97	            "mutation '{action}' is dangerous and requires an explicit approval decision; none was provided"
    98	        ))),
    99	    }
   100	}
