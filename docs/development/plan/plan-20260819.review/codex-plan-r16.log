    56	CREATE TABLE IF NOT EXISTS `agent_bridge_operation` (
    57	    `operation_id`   TEXT PRIMARY KEY,
    58	    `bridge_session_id` TEXT NOT NULL REFERENCES `agent_bridge_session`(`bridge_session_id`) ON DELETE CASCADE,
    59	    `method`         TEXT NOT NULL,
    60	    `params_digest`  TEXT NOT NULL,
    61	    `repository_id`  TEXT NOT NULL,
    62	    `workspace_id`   TEXT,
    63	    `status`         TEXT NOT NULL CHECK(`status` IN ('pending','applied','failed','quarantined')),
    64	    `result_digest`  TEXT,
    65	    `created_at`     INTEGER NOT NULL,
    66	    `completed_at`   INTEGER
    67	);
    68	
    69	-- Bridge-created checkpoints. `agent_checkpoint_id` is a soft link to the
    70	-- existing `agent_checkpoint` catalog (ADR-LB-02: link, don't alias).
    71	CREATE TABLE IF NOT EXISTS `agent_bridge_checkpoint` (
    72	    `checkpoint_id`       TEXT PRIMARY KEY,
    73	    `bridge_session_id`   TEXT NOT NULL REFERENCES `agent_bridge_session`(`bridge_session_id`) ON DELETE CASCADE,
    74	    `agent_checkpoint_id` TEXT,
    75	    `target_oid`          TEXT,
    76	    `created_at`          INTEGER NOT NULL
    77	);
    78	
    79	CREATE INDEX IF NOT EXISTS `idx_agent_bridge_checkpoint_session`
    80	    ON `agent_bridge_checkpoint`(`bridge_session_id`, `created_at`);
    81	
    82	-- Association catalog connecting bridge sessions/events/operations/checkpoints
    83	-- to existing AI/VCS objects. A stable (source_type, source_id) may only ever
    84	-- point at one target (prevents duplicate association on replay).
    85	CREATE TABLE IF NOT EXISTS `agent_bridge_link` (
    86	    `link_id`          INTEGER PRIMARY KEY AUTOINCREMENT,
    87	    `bridge_session_id` TEXT NOT NULL REFERENCES `agent_bridge_session`(`bridge_session_id`) ON DELETE CASCADE,
    88	    `source_type`      TEXT NOT NULL CHECK(`source_type` IN ('event','operation','checkpoint','evidence','provenance')),
    89	    `source_id`        TEXT NOT NULL,
    90	    `target_type`      TEXT NOT NULL,
